# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Node / build
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.vitest/

# Env / secrets — never commit keys (see ARCHITECTURE.md §Security)
.env
.env.*
*.pem
!**/test/fixtures/*.pem
!.env.example
infra/nakama/data/.cookie
infra/nakama/data/*.log

# data/ is the ODbL layer: derived/generated artifacts are reproducible
# by pinned build scripts (see data/README.md) and are never committed.
data/**
!data/README.md
!data/*.md

# Large source datasets pulled at build time
*.osm.pbf
*.osc.gz
*.poly
*.bsp

# Bake caches
.cache/
tmp/

# Local bake working area (raw downloads, COGs, ephemeris kernels — pinned
# scripts re-fetch everything; see DATA_SOURCES.md regeneration rules)
.bake/

# Playwright artifacts
playwright-report/
test-results/
blob-report/

# Local agent state
.claude/

# Go runtime plugin build artifacts (~17 MB each; the repo artifact is the
# source + server/runtime-go/README.md build procedure — never the .so)
server/runtime-go/*.so
infra/nakama/data/modules/*.so
