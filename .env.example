# =============================================================================
# Kwetu dev environment — TEMPLATE. Copy to `.env` and fill every value.
#
#   cp .env.example .env   (then generate real values — see below)
#
# Run the stack with the repo-root .env (compose otherwise looks for .env in
# the compose file's own directory):
#
#   docker compose --env-file .env -f infra/docker-compose.yml up -d
#
# SECURITY MODEL (ARCHITECTURE.md §10): these secrets ship with public
# default values upstream and MUST be changed before any deployment. Values
# here are placeholders, not usable credentials. Local dev values are
# generated once (e.g. `python -c "import secrets,string; print(''.join(
# secrets.choice(string.ascii_letters+string.digits) for _ in range(40)))"`)
# and live ONLY in the gitignored `.env`.
#
# KNOWN GAP: the repo-root .gitignore rule `.env.*` also matches this file,
# so .env.example is currently not tracked. A `!.env.example` exception in
# .gitignore is required to commit it (tracked in infra/README-dev.md open
# items; .gitignore is outside this task's write scope).
# =============================================================================

# --- Postgres (Nakama's durable layer; nothing else writes to it) -----------
POSTGRES_USER=nakama
POSTGRES_PASSWORD=__GENERATE_40_RANDOM_ALNUM__
POSTGRES_DB=nakama

# --- Nakama secrets (ARCHITECTURE.md §10: every one of these must change) ---
# socket.server_key        — client socket authentication
NAKAMA_SOCKET_SERVER_KEY=__GENERATE_40_RANDOM_ALNUM__
# session.encryption_key   — signs session JWTs
NAKAMA_SESSION_ENCRYPTION_KEY=__GENERATE_40_RANDOM_ALNUM__
# session.refresh_encryption_key — signs refresh tokens
NAKAMA_SESSION_REFRESH_ENCRYPTION_KEY=__GENERATE_40_RANDOM_ALNUM__
# runtime.http_key         — server-to-server HTTP RPC auth
NAKAMA_RUNTIME_HTTP_KEY=__GENERATE_40_RANDOM_ALNUM__
# console login (console is internal-only in production; dev publishes it on
# the loopback interface only — see infra/README-dev.md)
NAKAMA_CONSOLE_USERNAME=kwetu_dev
NAKAMA_CONSOLE_PASSWORD=__GENERATE_40_RANDOM_ALNUM__

# --- LiveKit (API keys live only server-side; never sent to browsers) ------
# Pair generation: `docker run --rm livekit/livekit-server:v1.13.6 generate-keys`
LIVEKIT_API_KEY=__GENERATE_OR_USE_GENERATE_KEYS__
LIVEKIT_API_SECRET=__GENERATE_OR_USE_GENERATE_KEYS__

# --- Host port bindings (all bind 127.0.0.1 only; see infra/README-dev.md) --
HOST_POSTGRES_PORT=15432
HOST_NAKAMA_API_PORT=7350
HOST_NAKAMA_CONSOLE_PORT=7351
HOST_CADDY_HTTPS_PORT=8443
HOST_LIVEKIT_HTTP_PORT=7880
